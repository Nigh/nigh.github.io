---
import '../styles/global.css';
import '../styles/markdown.css';
const base = import.meta.env.PUBLIC_BASE_URL;
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'xianii — Full-Stack Electronics Engineer',
  description = 'Personal site of xianii, a full-stack electronics engineer.',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={`${base}icon.png`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <style>
      @view-transition {
        navigation: auto;
      }
    </style>
    <title>{title}</title>
  </head>
  <body class="w-screen overflow-x-hidden">
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
  }
</style>
