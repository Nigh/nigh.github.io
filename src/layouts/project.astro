---
import { Icon } from 'astro-icon/components';
import Logo from '../components/project_icon.astro';

interface Props {
  title: string;
  slug: string;
  links?: Record<string, string>;
  icon?: string;
  image?: string[];
  description?: string;
  tags?: string[];
  lifecycle?: string;
}
const { title, slug, links, icon, image, description, tags = [], lifecycle } = Astro.props as Props;
const detailHref = `${import.meta.env.BASE_URL}project/${slug}/`;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-base-content/10 bg-base-200/60 p-5 transition hover:-translate-y-1 hover:border-primary/60 hover:bg-base-200"
>
  <div class="flex items-start gap-4">
    <div class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-base-100">
      <Logo title={title} icon={icon} />
    </div>
    <div class="min-w-0">
      {lifecycle && <time class="mb-1 block text-xs text-base-content/50">{lifecycle}</time>}
      <h2 class="text-lg font-bold leading-tight">{title}</h2>
    </div>
  </div>

  <p class="mt-4 grow text-sm leading-6 text-base-content/70">
    {description || 'Project details are being documented.'}
  </p>

  {
    tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.slice(0, 4).map((tag: string) => (
          <span class="rounded-full bg-primary/10 px-2 py-1 text-xs text-primary">{tag}</span>
        ))}
      </div>
    )
  }

  {
    image?.[0] && (
      <img
        src={image[0]}
        alt=""
        class="mt-4 max-h-40 w-full rounded-xl object-cover"
        loading="lazy"
      />
    )
  }

  <div class="mt-5 flex items-center gap-2">
    <a href={detailHref} class="btn btn-sm btn-primary">Case study</a>
    {
      links?.github && (
        <a
          href={links.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${title} on GitHub`}
          class="btn btn-sm btn-ghost"
        >
          <Icon name="mingcute:github-2-fill" size="18px" />
        </a>
      )
    }
    {
      links?.demo && (
        <a href={links.demo} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-ghost">
          Demo
        </a>
      )
    }
  </div>
</article>
