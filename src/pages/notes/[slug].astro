---
import Pages from '../../layouts/Pages.astro';
import { getCollection, type CollectionEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
      props: { post },
    }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Pages title={`${post.data.title} — Notes — xianii`} description={post.data.description}>
  <article>
    <header class="mb-10 border-b border-base-content/10 pb-8">
      <p class="text-sm text-base-content/50">{post.data.date.toISOString().slice(0, 10)}</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{post.data.title}</h1>
      {
        post.data.description && (
          <p class="mt-4 max-w-2xl text-base-content/70">{post.data.description}</p>
        )
      }
      {
        post.data.tags && (
          <div class="mt-4 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="rounded-full bg-primary/10 px-2.5 py-1 text-sm text-primary">{tag}</span>
            ))}
          </div>
        )
      }
    </header>
    <div class="markdown-body">
      <Content />
    </div>
  </article>
</Pages>
