---
import { getCollection } from 'astro:content';
import Project from '../../layouts/project.astro';
import Pages from '../../layouts/Pages.astro';
import { fetchRepoLifecycles, formatLifecycle } from '../../lib/github_repo_lifecycle.ts';

const projects = (await getCollection('projects')).filter((p) => !p.data.draft);
const lifecycles = await fetchRepoLifecycles(
  projects.map((p) => p.data.links?.github).filter((u): u is string => Boolean(u))
);

const sortedProjects = [...projects].sort((a, b) => {
  const ua = lifecycles.get(a.data.links?.github ?? '')?.updated?.getTime() ?? 0;
  const ub = lifecycles.get(b.data.links?.github ?? '')?.updated?.getTime() ?? 0;
  return ub - ua;
});
---

<Pages
  title="Projects — xianii"
  description="Selected software, hardware, and maker projects by xianii."
>
  <section>
    <p class="text-sm font-medium uppercase tracking-[0.2em] text-primary">Selected work</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">Projects</h1>
    <p class="mt-4 max-w-2xl leading-7 text-base-content/70">
      Software, embedded systems, and small experiments built to solve real problems or explore a
      new idea.
    </p>
  </section>

  <section class="mt-10">
    <div class="mb-5 flex items-center justify-between">
      <h2 class="text-lg font-semibold">{sortedProjects.length} projects</h2>
      <span class="text-sm text-base-content/50">Recently active first</span>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {
        sortedProjects.map((post) => {
          const gh = post.data.links?.github;
          const life = gh ? lifecycles.get(gh) : undefined;
          return (
            <Project
              slug={post.id.replace(/\.(md|mdx)$/, '')}
              {...post.data}
              lifecycle={formatLifecycle(life)}
            />
          );
        })
      }
    </div>
  </section>
</Pages>
