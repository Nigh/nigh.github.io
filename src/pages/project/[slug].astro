---
import Pages from '../../layouts/Pages.astro';
import { getCollection, type CollectionEntry, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import ProjectIcon from '../../components/project_icon.astro';
import {
  fetchRepoLifecycles,
  formatLifecycle,
} from '../../lib/github_repo_lifecycle.ts';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((p) => !p.data.draft);
  const lifecycles = await fetchRepoLifecycles(
    projects.map((p) => p.data.links?.github).filter((u): u is string => Boolean(u))
  );
  return projects.map((project) => {
    const gh = project.data.links?.github;
    const life = gh ? lifecycles.get(gh) : undefined;
    return {
      params: { slug: project.id.replace(/\.(md|mdx)$/, '') },
      props: { project, lifecycle: formatLifecycle(life) },
    };
  });
}

interface Props {
  project: CollectionEntry<'projects'>;
  lifecycle: string;
}
const { project, lifecycle } = Astro.props;
const { Content } = await render(project);
---

<Pages title={`${project.data.title} — Projects — xianii`} description={project.data.description}>
  <a
    href={`${import.meta.env.BASE_URL}project/`}
    class="mb-6 inline-flex items-center gap-1 text-sm font-medium text-base-content/60 transition hover:text-primary"
  >
    ← Back to Projects
  </a>
  <header class="mb-10 rounded-3xl border border-base-content/10 bg-base-200/60 p-6 sm:p-8">
    <div class="flex items-start gap-5">
      <div class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl bg-base-100">
        <ProjectIcon title={project.data.title} icon={project.data.icon} />
      </div>
      <div>
        <p class="text-sm font-medium text-primary">
          {lifecycle ? `Project · ${lifecycle}` : 'Project'}
        </p>
        <h1 class="mt-1 text-3xl font-bold tracking-tight sm:text-4xl">{project.data.title}</h1>
      </div>
    </div>
    <p class="mt-5 max-w-3xl leading-7 text-base-content/70">
      {project.data.description || 'Project details are being documented.'}
    </p>
    <div class="mt-5 flex flex-wrap items-center gap-2">
      {
        project.data.tags?.map((tag) => (
          <span class="rounded-full bg-primary/10 px-2.5 py-1 text-sm text-primary">{tag}</span>
        ))
      }
      {
        project.data.links?.github && (
          <a
            href={project.data.links.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-sm btn-primary"
          >
            <Icon name="mingcute:github-2-fill" size="18px" />
            Source
          </a>
        )
      }
      {
        project.data.links?.demo && (
          <a
            href={project.data.links.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-sm btn-ghost"
          >
            View demo
          </a>
        )
      }
    </div>
  </header>
  <div class="markdown-body">
    <Content />
  </div>
</Pages>
