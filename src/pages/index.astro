---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import IndexPage from '../layouts/IndexPage.astro';

const base = import.meta.env.BASE_URL;

const projects = (await getCollection('projects')).filter((p) => !p.data.draft);

type WallCard = { title: string; icon?: string; image?: string };
const cards: WallCard[] = [
  ...projects.map((p) => ({ title: p.data.title, icon: p.data.icon })),
  ...projects
    .filter((p) => p.data.image?.length)
    .map((p) => ({ title: p.data.title, image: p.data.image![0] })),
];

// 每行完整列表 + 独立洗牌（种子=行号，构建可复现）
const ROWS = 4;
function shuffle<T>(arr: T[], seed: number): T[] {
  const a = [...arr];
  let s = seed + 1;
  const rnd = () => {
    s = (s * 16807) % 2147483647;
    return (s - 1) / 2147483646;
  };
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(rnd() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
const rows = Array.from({ length: ROWS }, (_, i) => shuffle(cards, i));
---

<IndexPage>
  <div class="relative min-h-screen overflow-hidden">
    <div class="wall pointer-events-none absolute select-none" aria-hidden="true">
      {
        rows.map((row, i) => (
          <div
            class:list={['wall-row', i % 2 ? 'reverse' : '']}
            style={`animation-duration: ${90 + i * 15}s`}
          >
            {[row, row].map((half) => (
              <div class="wall-track">
                {half.map((card) =>
                  card.image ? (
                    <div class="wall-card w-72 overflow-hidden p-0">
                      <img
                        src={card.image}
                        alt=""
                        loading="lazy"
                        class="h-full w-full object-cover"
                      />
                    </div>
                  ) : (
                    <div class="wall-card flex-col gap-3 p-5">
                      <div class="grid h-14 w-14 place-items-center">
                        {card.icon?.startsWith('http') ? (
                          <img src={card.icon} alt="" loading="lazy" class="object-contain" />
                        ) : (
                          <Icon
                            name={card.icon || 'mingcute:pic-fill'}
                            size="56"
                            class={card.icon ? 'text-primary/60' : 'text-current/40'}
                          />
                        )}
                      </div>
                      <span class="max-w-40 truncate text-sm text-base-content/60">
                        {card.title}
                      </span>
                    </div>
                  )
                )}
              </div>
            ))}
          </div>
        ))
      }
    </div>

    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,var(--color-base-100)_25%,transparent_75%)]"
    >
    </div>

    <section
      class="relative mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center px-5 py-24 text-center"
    >
      <a href={`${base}about/`} class="group" aria-label="About xianii">
        <img
          src={`${base}xianii.webp`}
          alt="xianii"
          class="ring-primary ring-offset-base-100 h-40 w-40 rounded-full object-cover ring-4 ring-offset-4 transition group-hover:scale-105 sm:h-48 sm:w-48"
        />
      </a>
      <h1 class="mt-8 text-5xl font-bold tracking-tight sm:text-6xl">xianii</h1>
      <p class="mt-4 text-lg font-medium uppercase tracking-[0.16em] text-primary">
        Full-Stack Electronics Engineer
      </p>
      <p class="mt-6 max-w-xl text-base leading-7 text-base-content/70">
        Building useful things from circuits to software — embedded systems, practical tools, and
        small experiments.
      </p>
      <a href={`${base}about/`} class="btn btn-primary mt-9">About me</a>
    </section>
  </div>
</IndexPage>

<style>
  .wall {
    inset: -20%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2.5rem;
    transform: rotate(-8deg);
    opacity: 0.4;
  }
  .wall-row {
    display: flex;
    width: max-content;
    animation: marquee 90s linear infinite;
  }
  .wall-row.reverse {
    animation-direction: reverse;
  }
  .wall-track {
    display: flex;
    gap: 2.5rem;
    padding-right: 2.5rem;
  }
  .wall-card {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 10rem;
    min-width: 10rem;
    flex: none;
    border-radius: 1rem;
    border: 1px solid color-mix(in oklab, var(--color-base-content) 10%, transparent);
    background: color-mix(in oklab, var(--color-base-200) 60%, transparent);
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wall-row {
      animation: none;
    }
  }
</style>
